[Unit]
Description=marcAsério Check-in
After=network-online.target
Wants=network-online.target

[Service]
User=marcaserio
Group=marcaserio
# Só escuta localmente: o acesso público entra pelo Cloudflare Tunnel.
Environment=MA_HOST=127.0.0.1
Environment=MA_PORT=8770
Environment=MA_PUBLIC_URL=https://__DOMAIN__
Environment=MA_PRINT_MODE=agente
Environment=MA_TRUST_PROXY=1
Environment=MA_OPEN_BROWSER=0
Environment=MA_DATA_DIR=/var/lib/marcaserio
ExecStart=/usr/bin/python3 -u /opt/marcaserio/marcaserio_checkin.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/marcaserio

[Install]
WantedBy=multi-user.target
